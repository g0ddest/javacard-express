<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>name.velikodniy</groupId>
        <artifactId>javacard-express</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>javacard-express-container</artifactId>

    <name>JavaCard Express :: Container</name>
    <description>Testcontainers-based smart card simulation for integration testing</description>

    <dependencies>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>javacard-express-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
        </dependency>

        <!-- Core test classes (HelloWorldApplet etc.) -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>javacard-express-core</artifactId>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>

        <!-- For testing -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <properties>
        <!-- Location of the runnable simulator server jar inside this artifact (see SmartCardContainer). -->
        <simulator.server.dir>${project.build.outputDirectory}/name/velikodniy/jcexpress/container</simulator.server.dir>
        <simulator.server.classes>${project.build.directory}/simulator-server/classes</simulator.server.classes>
    </properties>

    <build>
        <plugins>
            <!-- Compile the simulator server from its single source of truth (../docker/src/main/java) into a
                 separate directory, at the Java level of the docker/ project, so it can be bundled below. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <executions>
                    <execution>
                        <id>compile-simulator-server</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                        <configuration>
                            <release>17</release>
                            <compileSourceRoots>
                                <compileSourceRoot>${project.basedir}/../docker/src/main/java</compileSourceRoot>
                            </compileSourceRoots>
                            <outputDirectory>${simulator.server.classes}</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Package server classes + jCardSim as a runnable jar resource of this artifact, so that
                 @SmartCard(mode = CONTAINER) works in any project without docker/ or a pre-built image. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <version>3.7.1</version>
                <executions>
                    <execution>
                        <id>simulator-server-jar</id>
                        <phase>process-classes</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                        <configuration>
                            <descriptors>
                                <descriptor>src/assembly/simulator-server.xml</descriptor>
                            </descriptors>
                            <finalName>jcx-simulator-server</finalName>
                            <appendAssemblyId>false</appendAssemblyId>
                            <attach>false</attach>
                            <outputDirectory>${simulator.server.dir}</outputDirectory>
                            <archive>
                                <manifest>
                                    <mainClass>name.velikodniy.jcexpress.server.JcxServer</mainClass>
                                </manifest>
                                <manifestEntries>
                                    <Implementation-Title>jcx-simulator</Implementation-Title>
                                    <Implementation-Version>${project.version}</Implementation-Version>
                                </manifestEntries>
                            </archive>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Server classes are visible to the tests (unit tests of the server package). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <additionalClasspathElements>
                        <additionalClasspathElement>${simulator.server.classes}</additionalClasspathElement>
                    </additionalClasspathElements>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
