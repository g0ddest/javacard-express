<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>name.velikodniy</groupId>
        <artifactId>javacard-express</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>javacard-express-maven-plugin</artifactId>
    <packaging>maven-plugin</packaging>

    <name>JavaCard Express :: Maven Plugin</name>
    <description>Maven plugin for building JavaCard CAP files with convention-over-configuration</description>

    <properties>
        <maven-invoker-plugin.version>3.10.1</maven-invoker-plugin.version>
        <javax.inject.version>1</javax.inject.version>

        <!-- Integration tests (src/it, run by maven-invoker-plugin in the integration-test phase).
             -DskipITs (or -DskipTests / -Dmaven.test.skip) skips them. -->
        <skipITs>false</skipITs>
        <!-- Oracle off-card verifier in the ITs (black box, only when the SDK is present):
             report = run and log the result, strict = fail the IT on verifier errors, skip = do not run. -->
        <jcx.it.verifycap>report</jcx.it.verifycap>
        <jcx.oracle.sdk>${project.basedir}/../build/oracle-sdks/jc305u3_kit</jcx.oracle.sdk>
        <!-- The build extension's entry point, compiled for Java 8 (see maven-compiler-plugin below) -->
        <extension.entry>name/velikodniy/jcexpress/plugin/JavaCardSetup.java</extension.entry>
    </properties>

    <dependencies>
        <!-- Maven Plugin API -->
        <dependency>
            <groupId>org.apache.maven</groupId>
            <artifactId>maven-plugin-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.maven.plugin-tools</groupId>
            <artifactId>maven-plugin-annotations</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.maven</groupId>
            <artifactId>maven-core</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>javax.inject</groupId>
            <artifactId>javax.inject</artifactId>
            <version>${javax.inject.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Converter -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>javacard-express-converter</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- The javac check: the build extension puts it on the annotation processor path of applet projects
             and passes it this goal's settings under the option names it declares -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>javacard-express-javac-plugin</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- JavaCard API stubs (needed for test applet compilation and installed for the ITs) -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>javacard-express-api</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Testing toolkit: installed for the ITs that run a jCardSim test (the README Quick Start). The build
             extension adds javacard-express-core and javacard-express-livecard to such projects, so the ITs need
             this build's toolkit, never a published one. Declared here (without their dependencies, so that
             jCardSim cannot shadow the API stubs the unit tests compile against) only to build them before this
             module in the reactor. -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>javacard-express-core</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>javacard-express-livecard</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- Testing -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <!-- The build extension's entry point (JavaCardSetup) is compiled for Java 8: Maven reads the classes
                     listed in META-INF/sisu/javax.inject.Named with a class scanner, the scanner of Maven 3.9.0 to
                     3.9.9 skips class files newer than Java 11, and Maven 3.9 runs on JDK 8, which cannot load newer
                     ones; either way without a word. The entry point stops a build on a JDK older than 25 with that
                     reason. Everything else is Java 25. -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-compile</id>
                        <configuration>
                            <excludes>
                                <exclude>${extension.entry}</exclude>
                            </excludes>
                        </configuration>
                    </execution>
                    <execution>
                        <id>compile-extension-entry</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                        <configuration>
                            <release>8</release>
                            <compilerArgs combine.self="override">
                                <!-- javac 21+ warns that release 8 is obsolete; the old target is intentional -->
                                <arg>-Xlint:-options</arg>
                            </compilerArgs>
                            <includes>
                                <include>${extension.entry}</include>
                            </includes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-plugin-plugin</artifactId>
                <configuration>
                    <!-- Stable Maven 3 APIs: AbstractMojo, MavenProject, MavenProjectHelper and JSR-330 for the goal,
                         and for the build extension maven-core's AbstractMavenLifecycleParticipant and the project
                         model it adds to. Do not demand the maven-plugin-api version the plugin is compiled with. -->
                    <requiredMavenVersion>3.9.0</requiredMavenVersion>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-invoker-plugin</artifactId>
                <version>${maven-invoker-plugin.version}</version>
                <configuration>
                    <projectsDirectory>src/it</projectsDirectory>
                    <cloneProjectsTo>${project.build.directory}/it</cloneProjectsTo>
                    <localRepositoryPath>${project.build.directory}/it-repo</localRepositoryPath>
                    <settingsFile>src/it/settings.xml</settingsFile>
                    <pomIncludes>
                        <pomInclude>*/pom.xml</pomInclude>
                    </pomIncludes>
                    <extraArtifacts>
                        <extraArtifact>${project.groupId}:javacard-express-api:${project.version}:jar</extraArtifact>
                        <extraArtifact>${project.groupId}:javacard-express-core:${project.version}:jar</extraArtifact>
                        <!-- with its dependencies (javacard-express-gp ...), from this reactor -->
                        <extraArtifact>${project.groupId}:javacard-express-livecard:${project.version}:jar</extraArtifact>
                        <!-- Surefire runs the JUnit 4 tests of extension-junit4-parent through the vintage engine: resolved
                             here, so that a build without network finds it once the local repository has it -->
                        <extraArtifact>org.junit.vintage:junit-vintage-engine:${junit.version}:jar</extraArtifact>
                    </extraArtifacts>
                    <postBuildHookScript>verify</postBuildHookScript>
                    <addTestClassPath>true</addTestClassPath>
                    <scriptVariables>
                        <projectVersion>${project.version}</projectVersion>
                        <verifycapMode>${jcx.it.verifycap}</verifycapMode>
                        <oracleSdk>${jcx.oracle.sdk}</oracleSdk>
                    </scriptVariables>
                    <parallelThreads>4</parallelThreads>
                    <streamLogsOnFailures>true</streamLogsOnFailures>
                    <showErrors>true</showErrors>
                    <skipInstallation>${skipITs}</skipInstallation>
                    <skipInvocation>${skipITs}</skipInvocation>
                    <failIfNoProjects>true</failIfNoProjects>
                </configuration>
                <executions>
                    <execution>
                        <id>integration-test</id>
                        <goals>
                            <goal>install</goal>
                            <goal>run</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>skip-its-with-tests</id>
            <activation>
                <property>
                    <name>skipTests</name>
                </property>
            </activation>
            <properties>
                <skipITs>true</skipITs>
            </properties>
        </profile>
        <profile>
            <id>skip-its-with-test-compilation</id>
            <activation>
                <property>
                    <name>maven.test.skip</name>
                </property>
            </activation>
            <properties>
                <skipITs>true</skipITs>
            </properties>
        </profile>
        <profile>
            <!-- When the outer build reads artifacts from a read-only tail repository
                 (-Dmaven.repo.local.tail=...), let the IT builds read from it as well
                 instead of downloading every build plugin again. -->
            <id>it-local-repo-tail</id>
            <activation>
                <property>
                    <name>maven.repo.local.tail</name>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-invoker-plugin</artifactId>
                        <configuration>
                            <properties>
                                <maven.repo.local.tail>${maven.repo.local.tail}</maven.repo.local.tail>
                            </properties>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
